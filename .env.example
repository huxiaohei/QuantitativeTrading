# 复制为 .env 后按需填写；.env 已被 git 忽略，切勿提交真实凭据

# 数据库（compose 内的 worker 会自动覆盖为 db 服务地址；本机管理命令用 54330 端口）
DATABASE_URL=postgresql+psycopg://qt:qt@127.0.0.1:54330/qt

# compose 里数据库服务的密码（本地默认 qt；部署到别处请改成强密码）
POSTGRES_PASSWORD=qt

# 邮件：MAIL_BACKEND 取 smtp 或 file（file 只把邮件写到文件，不发送）
MAIL_BACKEND=file
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
ADMIN_EMAIL=
# MAIL_BACKEND=file 时邮件写成 .eml 文件的目录
# compose 已为容器设置 MAIL_FILE_DIR=/app/mail_out（映射到宿主机 ./mail_out）；在本机直接运行时才需要取消注释并改成本机路径
# MAIL_FILE_DIR=./mail_out

# 网页对外地址：邮件里的链接用它拼出；线上必须是 https，本机开发用 http://localhost:8000
QT_BASE_URL=http://localhost:8000
# 服务器上：QT_BASE_URL=https://<你的域名>，并设置 QT_SITE=<你的域名>（不带 https:// 和路径）
# 两者必须是同一个域名：QT_SITE 给反向代理申请证书，QT_BASE_URL 用于邮件链接和来源校验
# 本机开发不需要 QT_SITE（反向代理只在服务器的 public 档位启动）
QT_SITE=

# 数据目录（宿主机路径，挂载到容器 /app/data）
QT_DATA_DIR=./data

# 访问数据源的代理；服务器能直接访问数据源时请清空这两项；容器内访问宿主机代理用 host.docker.internal
HTTP_PROXY=http://host.docker.internal:7897
HTTPS_PROXY=http://host.docker.internal:7897
