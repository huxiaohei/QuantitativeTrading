# 复制为 .env 后按需填写；.env 已被 git 忽略，切勿提交真实凭据

# 数据库（compose 内的 worker 会自动覆盖为 db 服务地址；本机管理命令用 54330 端口）
DATABASE_URL=postgresql+psycopg://qt:qt@127.0.0.1:54330/qt

# 邮件：MAIL_BACKEND 取 smtp 或 file（file 只把邮件写到文件，不发送）
MAIL_BACKEND=file
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
ADMIN_EMAIL=

# 数据目录（宿主机路径，挂载到容器 /app/data）
QT_DATA_DIR=./data

# 访问数据源的代理；容器内访问宿主机代理用 host.docker.internal
HTTP_PROXY=http://host.docker.internal:7897
HTTPS_PROXY=http://host.docker.internal:7897
